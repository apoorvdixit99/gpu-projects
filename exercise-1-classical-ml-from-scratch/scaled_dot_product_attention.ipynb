   "source": [
    "import torch\n",
    "import math\n",
    "\n",
    "def attention(Q, K, V):\n",
    "    d_k = K.shape[-1]\n",
    "    scores = Q @ K.transpose(-2, -1)\n",
    "    scores = scores / math.sqrt(d_k)\n",
    "    weights = torch.softmax(scores, dim=-1)\n",
    "    output = weights @ V\n",
    "    return output"
   ]
  }
